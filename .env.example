# ============================================================
# Autonomous Prime Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Groq ---
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama (local LLM fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- ComfyUI ---
COMFYUI_URL=http://localhost:8188
COMFYUI_OUTPUT_DIR=C:/Users/Mark g/Desktop/AI/ComfyUI/output

# --- Coqui TTS ---
COQUI_URL=http://localhost:5002
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
COQUI_LANGUAGE=en
COQUI_SPEAKER_WAV=C:/Users/Mark g/voice.wav
TTS_HOME=./data/tts-cache
COQUI_TOS_AGREED=1

# --- SpeechRecognition Captions (primary, free, uses Google Speech API) ---
SR_ENABLED=true
SR_CHUNK_SECONDS=30
SR_LANGUAGE=en-US
SR_BURN_IN=false

# --- Whisper Captions (local fallback, no API key, higher accuracy) ---
# Used automatically when SpeechRecognition fails or SR_ENABLED=false
# Models: tiny, base, small, medium, large (larger = more accurate but slower)
WHISPER_ENABLED=false
WHISPER_MODEL=base
WHISPER_BURN_IN=false

# --- FFmpeg ---
FFMPEG_BIN=ffmpeg
FFMPEG_DOWNLOAD_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl-shared.zip

# --- WordPress / Blog Publishing ---
WP_URL=https://your-site.com
WP_USER=your_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Social Media ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_API_KEY=

# --- Reddit (OAuth2 Script app — create at reddit.com/prefs/apps) ---
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_POST_TYPE=link

# --- Threads (Meta Threads Graph API v1.0) ---
# Get user token from Meta Developer Portal with threads_basic + threads_content_publish scopes
THREADS_ENABLED=false
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Replicate ---
REPLICATE_API_KEY=r8_...
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# --- Gmail SMTP Autoresponder ---
# Get app password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
FROM_NAME=Autonomous Prime
BASE_URL=http://localhost:3001

# --- Stripe Billing ---
STRIPE_SECRET_KEY=sk_live_sk_live_51RAirJGLGzlIYvX2HnT9gptN3zQzQlYjhtrMHobDumiMtrfzjEFRWY9iy7NBBl9nv2DA7HbrC6aCOjPSzxfcvaRZ00mJtf9ZsR
